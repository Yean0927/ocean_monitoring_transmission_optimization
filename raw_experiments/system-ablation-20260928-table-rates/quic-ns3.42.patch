+bool
+QuicSocketTxBuffer::MarkOldestOutstandingAsLost ()
+{
+  for (auto item : m_sentList)
+    {
+      if (!item->m_sacked && !item->m_lost)
+        {
+          item->m_lost = true;
+          return true;
+        }
+    }
+  return false;
+}
